{
    "_metadata": {
            "colors": {
                "format": "RGB (Red, Green, Blue)"
            },
            "fonts": {
                "directory": "/assets/fonts",
                "format": "Each font requires: 'file' name and 'size' integer"
            }
        }, 
        
    "window": {
        "width": 700,
        "height": 500,
        "fps": 60,
        "init_screen": "MAIN-SCREEN",
        "await_all_tasks": false,
        "colors": {
            "background": [28, 27, 27],
            "button_base": [67, 64, 57],
            "button_hover": [72, 72, 74],
            "plain_txt": [228, 215, 183],
            "title_txt": [228, 215, 183],
            "pitch": [17, 19, 17],
            "onyx": [19, 17, 19],
            "carbon": [28, 27, 27],
            "moss": [54, 60, 53],
            "obsidian": [59, 53, 60],
            "shadow": [67, 61, 68],
            "mud": [67, 64, 57],
            "slate": [72, 72, 74],
            "aubergine": [97, 64, 81],
            "sage": [91, 101, 89],
            "thistle": [99, 89, 101],
            "parchment": [228, 215, 183]
        },
        "fonts": {
             "warning":{
                "file": "Quicksand/Quicksand-Regular.ttf",
                "size": 50
            },
            "default":{
                "file": "Quicksand/Quicksand-Regular.ttf",
                "size": 30
            },
            "sml_button": {
                "file": "Metamorphous/Metamorphous-Regular.ttf",
                "size": 30
            },
            "mid_button": {
                "file": "Metamorphous/Metamorphous-Regular.ttf",
                "size": 40
            },
            "big_button": {
                "file": "Metamorphous/Metamorphous-Regular.ttf",
                "size": 50
            },
            "title_main_screen": {
                "file": "Uncial_Antiqua/UncialAntiqua-Regular.ttf",
                "size": 65
            },
            "title_secondary_screen": {
                "file": "Uncial_Antiqua/UncialAntiqua-Regular.ttf",
                "size": 65
            }
        }
    },

    "main_screen": {
        "ID": "MAIN-SCREEN",
        "elements": {
            "screen_title": {
                "type": "text",
                "text": "APP GENERATOR",
                "position": {"x": 30, "y": 50},
                "font": "title_main_screen",
                "color": "title_txt"
            },
            "secondary_button": {
                "type": "button",
                "subtype": "text",
                "position" : {"x": 50, "y": 250},
                "size": {"width": 150, "height": 150},
                "text": "SEC.",
                "font": "sml_button",
                "color": {"base": "thistle", "hover": "aubergine"},
                "redirection": "SECONDARY-SCREEN",
                "functions": [""]
            },
            "tertiary_button": {
                "type": "button",
                "subtype": "text",
                "position" : {"x": 275, "y": 250},
                "size": {"width": 150, "height": 150},
                "text": "TER.",
                "font": "sml_button",
                "color": {"base": "thistle", "hover": "aubergine"},
                "redirection": "TERTIARY-SCREEN",
                "functions": [""]
            },
            "exit_button": {
                "type": "button",
                "subtype": "text",
                "position" : {"x": 500, "y": 250},
                "size": {"width": 150, "height": 150},
                "text": "EXIT",
                "font": "sml_button",
                "color": {"base": "thistle", "hover": "aubergine"},
                "redirection": "",
                "functions": ["exit"]
            },
            "logo_image":{
                "type": "image",
                "file": "rachelxcii_logo.png",
                "position" : {"x": 325, "y": 425},
                "size": {"width": 50, "height": 50},
                "tint_color": "thistle"
            }
        }
    },
    
    "secondary_screen": {
        "ID": "SECONDARY-SCREEN",
        "elements": {
            "return_button": {
                "type": "button",
                "subtype": "image",
                "position" : {"x": 50, "y": 50},
                "size": {"width": 50, "height": 100},
                "file": {
                    "base": "return_button.png", 
                    "hover": "return_button.png"
                },
                "redirection": "MAIN-SCREEN",
                "functions": [""],
                "tint_color": {"base": "thistle", "hover": "aubergine"},
                "rotation": {"base": false, "hover": true}
            },
            "screen_title": {
                "type": "text",
                "text": "SECONDARY",
                "position": {"x": 100, "y": 50},
                "size": {"width": 50, "height": 100},
                "font": "title_secondary_screen",
                "color": "title_txt"
            },
            "user_input_prompt": {
                "type": "text_input",
                "position": {"x": 100, "y": 150},
                "size": {"width": 550, "height": 50},
                "font": "default",
                "placeholder": "Pega aquí tu texto para procesar...",
                "max_chars": 100,
                "allow_multiline": false,
                "colors": {
                    "background": "onyx",
                    "passive": "shadow",
                    "active": "parchment",
                    "text": "parchment"
                }
            },
            "output_prompt": {
                "type": "text_output",
                "subtype": "text",
                "position": {"x": 100, "y": 200},
                "size": {"width": 550, "height": 50},
                "font": "default",
                "color": "thistle",
                "initial_text": "",
                "monitored_functions": ["sleep_timer", "read_prompt"]
            },
            "read_user_prompt_button": {
                "type": "button",
                "subtype": "text",
                "position" : {"x": 300, "y": 250},
                "size": {"width": 150, "height": 150},
                "text": "READER",
                "font": "sml_button",
                "color": {"base": "thistle", "hover": "aubergine"},
                "redirection": "",
                "functions": ["read_prompt"],
                "inputs": ["user_input_prompt"]
            },
            "timer_button": {
                "type": "button",
                "subtype": "text",
                "position" : {"x": 100, "y": 250},
                "size": {"width": 150, "height": 150},
                "text": "TIMER",
                "font": "sml_button",
                "color": {"base": "thistle", "hover": "aubergine"},
                "redirection": "",
                "functions": ["sleep_timer"],
                "outputs": ["output_prompt"]
            },
            "loading_timer": {
                "type": "loading_icon",
                "monitored_functions": ["sleep_timer"],
                "position": {"x": 150, "y": 350},
                "size": {"width": 50, "height": 50},
                "rotation": true,
                "file": "loading_transparent.gif"
            },
            "logo_image":{
                "type": "image",
                "file": "rachelxcii_logo.png",
                "position" : {"x": 325, "y": 425},
                "size": {"width": 50, "height": 50},
                "tint_color": "thistle"
            },
            "cancel_tasks_button": {
                "type": "button",
                "subtype": "text",
                "position" : {"x": 500, "y": 250},
                "size": {"width": 150, "height": 150},
                "text": "CANCEL TASKS",
                "font": "sml_button",
                "color": {"base": "thistle", "hover": "aubergine"},
                "redirection": "",
                "functions": ["cancel_pending_tasks"]
            }
        }
    },
    
    "third_screen": {
        "ID": "TERTIARY-SCREEN",
        "elements": {
            "return_button": {
                "type": "button",
                "subtype": "image",
                "position" : {"x": 50, "y": 50},
                "size": {"width": 50, "height": 100},
                "file": {
                    "base": "return_button.png", 
                    "hover": "return_button.png"
                },
                "redirection": "MAIN-SCREEN",
                "functions": [""],
                "tint_color": {"base": "thistle", "hover": "aubergine"},
                "rotation": {"base": false, "hover": true}
            },
            "screen_title": {
                "type": "text",
                "text": "SECONDARY",
                "position": {"x": 100, "y": 50},
                "size": {"width": 50, "height": 100},
                "font": "title_secondary_screen",
                "color": "title_txt"
            },
            "user_input_prompt": {
                "type": "text_input",
                "position": {"x": 100, "y": 150},
                "size": {"width": 550, "height": 50},
                "font": "default",
                "placeholder": "Pega aquí tu texto para procesar...",
                "max_chars": 100,
                "allow_multiline": false,
                "colors": {
                    "background": "onyx",
                    "passive": "shadow",
                    "active": "parchment",
                    "text": "parchment"
                }
            }
}