{
    "_metadata": {
            "colors": {
                "format": "RGB (Red, Green, Blue)"
            },
            "fonts": {
                "directory": "/assets/fonts",
                "format": "Each font requires: 'file' name and 'size' integer"
            }
        }, 
        
    "display": {
        "width": 700,
        "height": 500,
        "fps": 60,
        "init_screen": "MAIN-SCREEN",
        "colors": {
            "background": [28, 27, 27],
            "button_base": [67, 64, 57],
            "button_hover": [72, 72, 74],
            "plain_txt": [228, 215, 183],
            "title_txt": [228, 215, 183],
            "tint_color": [255, 0, 0]
        },
        "fonts": {
            "sml_button": {
                "file": "Metamorphous/Metamorphous-Regular.ttf",
                "size": 30
            },
            "mid_button": {
                "file": "Metamorphous/Metamorphous-Regular.ttf",
                "size": 40
            },
            "big_button": {
                "file": "Metamorphous/Metamorphous-Regular.ttf",
                "size": 50
            },
            "title_main_screen": {
                "file": "Uncial_Antiqua/UncialAntiqua-Regular.ttf",
                "size": 65
            },
            "title_secondary_screen": {
                "file": "Uncial_Antiqua/UncialAntiqua-Regular.ttf",
                "size": 65
            }
        }
    },

    "main_screen": {
        "ID": "MAIN-SCREEN",
        "elements": {
            "screen_title": {
                "type": "text",
                "text": "APP GENERATOR",
                "position": {"x": 30, "y": 50},
                "font": "title_main_screen",
                "color": "title_txt"
            },
            "secondary_button": {
                "type": "button",
                "subtype": "text",
                "position" : {"x": 50, "y": 250},
                "size": {"width": 150, "height": 150},
                "text": "SEC.",
                "font": "sml_button",
                "color": {"base": "button_base", "hover": "button_hover"},
                "redirection": "SECONDARY-SCREEN",
                "functions": [""]
            },
            "useless_button": {
                "type": "button",
                "subtype": "text",
                "position" : {"x": 275, "y": 250},
                "size": {"width": 150, "height": 150},
                "text": "USELESS",
                "font": "sml_button",
                "color": {"base": "button_base", "hover": "button_hover"},
                "redirection": "",
                "functions": [""]
            },
            "exit_button": {
                "type": "button",
                "subtype": "text",
                "position" : {"x": 500, "y": 250},
                "size": {"width": 150, "height": 150},
                "text": "EXIT",
                "font": "sml_button",
                "color": {"base": "button_base", "hover": "button_hover"},
                "redirection": "",
                "functions": ["exit"]
            },
            "logo_image":{
                "type": "image",
                "file": "rachelxcii_logo_transparent.PNG",
                "position" : {"x": 325, "y": 425},
                "size": {"width": 50, "height": 50}
            }
        }
    },

    "generator_screen": {
        "ID": "SECONDARY-SCREEN",
        "elements": {
            "return_button": {
                "type": "button",
                "subtype": "image",
                "position" : {"x": 50, "y": 50},
                "size": {"width": 50, "height": 100},
                "image": {"base": "arrow_back.png", "hover": "arrow_back.png"},
                "redirection": "MAIN-SCREEN",
                "functions": [""],
                "tint_color": {"base": "", "hover": "tint_color"}
            },
            "screen_title": {
                "type": "text",
                "text": "SECONDARY",
                "position": {"x": 100, "y": 50},
                "size": {"width": 50, "height": 100},
                "font": "title_secondary_screen",
                "color": "title_txt"
            },
            "logo_image":{
                "type": "image",
                "file": "rachelxcii_logo_transparent.PNG",
                "position" : {"x": 325, "y": 425},
                "size": {"width": 50, "height": 50},
                "tint_color": "tint_color"
            }
        }
    }
}