{
    "_metadata": {
            "colors": {
                "format": "RGB (Red, Green, Blue)"
            },
            "fonts": {
                "directory": "/assets/fonts",
                "format": "Each font requires: 'file' name and 'size' integer"
            }
        }, 
        
    "window": {
        "width": 700,
        "height": 500,
        "fps": 60
    },

     "colors": {
        "background": [30, 30, 30],
        "button_base": [50, 50, 50],
        "button_hover": [100, 100, 100],
        "white_txt": [255, 255, 255],
        "title_main_screen": [200, 200, 200]
    },

    "fonts": {
        "sml_button": {
            "file": "SupermercadoOne-Regular.ttf",
            "size": 32
        },
        "mid_button": {
            "file": "SupermercadoOne-Regular.ttf",
            "size": 32
        },
        "big_button": {
            "file": "SupermercadoOne-Regular.ttf",
            "size": 32
        },
        "title_main_screen": {
            "file": "SupermercadoOne-Regular.ttf",
            "size": 100
        }
    },

    "main_screen": {
        "has_return": false,
        "title": {
            "name": "MAZE SOLVER",
            "size": 72,
            "position": {"x": 100, "y": 50},
            "font": "title_main_screen",
            "color": "title_main_screen"
        },
        "buttons": {
            "block_1": {
                "buttons": {
                    "Generator": {"actions": "goto"}, 
                    "Solver": {"actions": "goto"}, 
                    "Dashboard": {"actions": "goto"}
                },
                "alignment": "horizontal",
                "size": {"width": 150, "height": 150},
                "dist_to_edge": 50,
                "dist_between_buttons": 75,
                "position": {"x": 0, "y": 250},
                "font": "sml_button",
                "color": {
                    "base": "button_base",
                    "hover": "button_hover"
                }
            },
            "block_2": {
                "buttons": {
                    "Reset": {"actions": "function"}, 
                    "Exit": {"actions": "function"}
                },
                "alignment": "horizontal",
                "size": {"width": 100, "height": 50},
                "dist_to_edge": 150,
                "dist_between_buttons": 200,
                "position": {"x": 0, "y": 425},
                "font": "sml_button",
                "color": {
                    "base": "button_base",
                    "hover": "button_hover"
                }
            }
        }
    }
}