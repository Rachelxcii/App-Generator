{
    "_metadata": {
            "colors": {
                "format": "RGB (Red, Green, Blue)"
            },
            "fonts": {
                "directory": "/assets/fonts",
                "format": "Each font requires: 'file' name and 'size' integer"
            }
        }, 
        
    "window": {
        "width": 2100,
        "height": 1500,
        "fps": 60
    },

    "main_screen": {
        "has_return": false,
        "title": {
            "name": "Maze Generator & Solver",
            "size": 100,
            "position": {"x": 100}
        },
        "buttons": {
            "line_1": {
                "names": ["Generator", "Solver", "Dashboard"],
                "alignment": "horizontal",
                "size": {"width": 150, "height": 150},
                "dist_to_edge": 50,
                "dist_between_buttons": 75,
                "position": {"x": 0, "y": 250},
                "font": "sml_button",
                "color": {
                    "base": "button_base",
                    "hover": "button_hover"
                }
            },
            "line_2": {
                "names": ["Reset", "Exit"],
                "alignment": "horizontal",
                "size": {"width": 100, "height": 50},
                "dist_to_edge": 150,
                "dist_between_buttons": 200,
                "position": {"x": 0, "y": 425},
                "font": "sml_button",
                "color": {
                    "base": "button_base",
                    "hover": "button_hover"
                }
            }
        }
    },

    "colors": {
        "background": [30, 30, 30],
        "button_base": [50, 50, 50],
        "button_hover": [100, 100, 100],
        "text_white": [255, 255, 255]
    },

    "fonts": {
        "sml_button": {
            "file": "SupermercadoOne-Regular.ttf",
            "size": 32
        },
        "mid_button": {
            "file": "SupermercadoOne-Regular.ttf",
            "size": 32
        },
        "big_button": {
            "file": "SupermercadoOne-Regular.ttf",
            "size": 32
        },
        "main_title": {
            "file": "SupermercadoOne-Regular.ttf",
            "size": 100
        }
    }
}